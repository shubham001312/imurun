# Embed compiled SPIR-V into a C++ include so fish.dll needs no shader files.
#
#   cmake -DOUT=<file.inc> -DSPV_DIR=<dir> -DNAMES="matvec_Q4_K;..." -P embed_spv.cmake
#
# Each <SPV_DIR>/<name>.spv becomes `static const uint32_t kSpv_<name>[]`
# (SPIR-V is a little-endian stream of 32-bit words), plus a lookup table
# `kFishSpv[] = {name, code, words}` and `kFishSpvCount`.
if(NOT OUT OR NOT SPV_DIR OR NOT NAMES)
    message(FATAL_ERROR "embed_spv.cmake: OUT, SPV_DIR and NAMES are required")
endif()

set(body "// Generated by shaders/embed_spv.cmake from shaders/*.comp. Do not edit.\n")
string(APPEND body "#include <cstddef>\n#include <cstdint>\n\n")
set(table "struct FishSpv { const char* name; const uint32_t* code; size_t words; };\n")
string(APPEND table "static const FishSpv kFishSpv[] = {\n")
set(count 0)
foreach(name IN LISTS NAMES)
    set(path "${SPV_DIR}/${name}.spv")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "embed_spv.cmake: missing ${path}")
    endif()
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR rem "${hexlen} % 8")
    if(NOT rem EQUAL 0 OR hexlen EQUAL 0)
        message(FATAL_ERROR "embed_spv.cmake: ${path} is not a whole number of 32-bit words")
    endif()
    math(EXPR words "${hexlen} / 8")
    # aabbccdd (bytes in file order) -> 0xddccbbaa (little-endian word)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
           "0x\\4\\3\\2\\1," words_txt "${hex}")
    # Line breaks every 8 words keep the file diff-able.
    string(REGEX REPLACE "((0x[0-9a-f]+,){8})" "\\1\n    " words_txt "${words_txt}")
    string(APPEND body "static const uint32_t kSpv_${name}[${words}] = {\n    ${words_txt}\n};\n\n")
    string(APPEND table "    {\"${name}\", kSpv_${name}, ${words}},\n")
    math(EXPR count "${count} + 1")
endforeach()
string(APPEND table "};\nstatic const size_t kFishSpvCount = ${count};\n")
file(WRITE "${OUT}.tmp" "${body}${table}")
# Only touch the output when it changed, so a shader-less rebuild does not
# recompile the backend.
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
